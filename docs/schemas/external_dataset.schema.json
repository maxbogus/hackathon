{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExternalDatasetArtifact",
  "description": "Нормализованный артефакт внешних данных (шаг 0, ETL apps/harvester/app/build). Пишется в data/external/normalized/<name>.json вместе с manifest.json (sha256 каждого артефакта).",
  "type": "object",
  "required": ["source", "rows_count", "generated_at", "inputs"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["weather", "traffic", "poi", "events", "stops", "validators", "calendar", "user_routes"]
    },
    "rows": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Плоские строки источника (weather/traffic/poi/events/validators)."
    },
    "routes": {
      "type": "object",
      "description": "Маппинг route_id → список остановок (stops) или user-разметка (user_routes).",
      "additionalProperties": {}
    },
    "holidays": {
      "type": "array",
      "items": {"type": "string", "format": "date"},
      "description": "Праздники РФ (ISO-даты)."
    },
    "school_breaks": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "string", "format": "date"},
        "minItems": 2,
        "maxItems": 2
      },
      "description": "Школьные каникулы [начало, конец]."
    },
    "rows_count": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "description": "Детерминированная метка сборки (SOURCE_DATE_EPOCH/mtime)."},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "rows"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rows": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
