            }
          }
        }
      }
    },
    "/api/v1/predictions/stop/{stop_id}": {
      "get": {
        "tags": [
          "predictions"
        ],
        "summary": "Get ridership predictions for a stop",
        "description": "Return hourly predictions for [period_start, period_end] at one stop.\n\nReturns list of `{period_start, period_end, value, lower, upper, model_id}`.",
