        "parameters": [
          {
            "name": "stop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Stop Id"
            }
          },
          {
            "name": "period_start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Period Start"
            }
          },
          {
            "name": "period_end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Period End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Predictions For Stop Api V1 Predictions Stop  Stop Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions/eta": {
      "get": {
        "tags": [
          "predictions"
        ],
        "summary": "Get next N upcoming trams at a stop (ETA + predicted load)",
        "description": "Return the next N trams calling at `stop_id`.\n\nUsed by the passenger-mode UI (T-129) to render the \"next trams\" cards\nwith ETA + predicted load. The response shape (`ETAResponse`) is\nkept in sync with `apps/frontend/src/lib/recommend.ts`.\n\nBehaviour:\n    - Reads the active model from `ArtifactLoader`.\n    - Predicts hourly ridership over the next 60 minutes.\n    - Distributes predictions across N equal-width buckets\n      (see `app.data.transit.compute_eta_predictions`).\n    - Returns an empty `trams` list when the stop is unknown\n      (UI shows \"no data\").\n\nErrors:\n    - 503: no active model artifact (consistent with /models/active).\n    - 501: active model is not yet wired into the predictor dispatcher.",
        "operationId": "get_eta_predictions_api_v1_predictions_eta_get",
        "parameters": [
          {
            "name": "stop_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Tram stop id (1..N).",
              "title": "Stop Id"
            },
            "description": "Tram stop id (1..N)."
          },
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Number of upcoming trams to return. Clamped to [1, 5].",
              "default": 3,
              "title": "N"
            },
            "description": "Number of upcoming trams to return. Clamped to [1, 5]."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ETAResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
