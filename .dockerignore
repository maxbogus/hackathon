# Transit-AI .dockerignore (T-164)
# Исключает из build context всё, что не нужно в Docker image:
# - кэши Python/Node (ускоряет build на 30-50%)
# - .env с секретами (security)
# - tests/, docs/, scripts/ (не нужны в runtime image)
# - data/, predictions/, ml/artifacts/ (gitignored runtime данные)

# === Python кэши и venv ===
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# === Node (фронт) ===
# T-236: паттерны обязаны быть рекурсивными (`**/`) — они матчатся от корня контекста.
# Без этого `COPY apps/frontend ./` приносил из хоста stale `apps/frontend/.yarn/install-state.gz`
# и затирал state от `yarn install --immutable`, сборка образа падала с
# "Couldn't find the node_modules state file - running an install might help".
**/node_modules/
**/.yarn/cache
**/.yarn/install-state.gz
**/.yarn/unplugged
**/.pnp.*

# === Git и IDE ===
.git/
.gitignore
.gitattributes
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# === Secrets (security) ===
.env
.env.*
!.env.example
*.pem
*.key

# === Тесты, документация, скрипты (не нужны в runtime) ===
tests/
docs/
scripts/
# F-096: docs/schemas/prediction_artifact.schema.json нужен ArtifactLoader в runtime
!docs/schemas/

# === Runtime данные (gitignored, монтируются через volumes) ===
data/
predictions/
ml/artifacts/

# === Docker-специфичное ===
Dockerfile*
docker-compose*.yml
.dockerignore
# T-198b: allow wheels для offline build
!apps/backend/wheels/
!apps/harvester/wheels/
!apps/ml_pipeline/wheels/
!apps/backend/requirements.txt
!apps/harvester/requirements.txt
!apps/ml_pipeline/requirements.txt
