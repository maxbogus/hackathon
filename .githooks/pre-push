#!/usr/bin/env bash
# ============================================================================
# Transit-AI — pre-push hook
# ----------------------------------------------------------------------------
# Запускает mypy strict, pytest (unit), orval-check. Медленнее pre-commit.
# ============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

printf "\n${YELLOW}→ pre-push: running slow checks...${NC}\n"

# 1. mypy strict (только если менялся backend/assistant/mcp)
if git diff --stat origin/HEAD..HEAD --name-only 2>/dev/null | grep -qE '^apps/(backend|assistant|mcp)/.*\.py$'; then
  printf "${YELLOW}→ mypy strict...${NC}\n"
  uv run mypy apps/backend/app apps/assistant/app apps/mcp/ 2>&1 | tail -30 || {
    printf "${RED}✗ mypy failed. Run 'make typecheck'.${NC}\n"
    exit 1
  }
  printf "${GREEN}✓ mypy passed${NC}\n"
fi

# 2. pytest unit tests
printf "${YELLOW}→ pytest unit tests...${NC}\n"
uv run pytest apps/backend/tests ml/tests apps/assistant/tests apps/mcp/tests -m unit -q --no-cov 2>&1 | tail -20 || {
  printf "${RED}✗ pytest failed. Run 'make test'.${NC}\n"
  exit 1
}
printf "${GREEN}✓ pytest passed${NC}\n"

# 3. frontend tsc + vitest (если менялся фронт)
if git diff --stat origin/HEAD..HEAD --name-only 2>/dev/null | grep -qE '^apps/frontend/src/.*\.(ts|tsx)$'; then
  printf "${YELLOW}→ tsc + vitest...${NC}\n"
  cd apps/frontend && yarn typecheck 2>&1 | tail -10 || {
    printf "${RED}✗ tsc failed. Run 'make typecheck'.${NC}\n"
    cd ../..
    exit 1
  }
  yarn test:run 2>&1 | tail -10 || {
    printf "${RED}✗ vitest failed. Run 'make test'.${NC}\n"
    cd ../..
    exit 1
  }
  cd ../..
  printf "${GREEN}✓ frontend checks passed${NC}\n"
fi

# 4. pyscn quality gate (если менялся Python-код или скрипты)
if git diff --stat origin/HEAD..HEAD --name-only 2>/dev/null | grep -qE "^(apps|ml|scripts)/.*\.py$"; then
  printf "${YELLOW}→ pyscn quality gate...${NC}
"
  uv run python scripts/pyscn_compare.py     --baseline ai/analysis/pyscn-baseline.json     --current .pyscn/report.json 2>&1 | tail -15 || {
    printf "${RED}✗ pyscn regression. Run 'make pyscn' to see details.${NC}
"
    exit 1
  }
  printf "${GREEN}✓ pyscn passed${NC}
"
fi

# 5. DBML drift gate (если менялись SQLAlchemy-модели)
if git diff --stat origin/HEAD..HEAD --name-only 2>/dev/null | grep -qE "^apps/backend/app/models/"; then
  printf "${YELLOW}→ DBML drift check...${NC}
"
  uv run python scripts/generate_dbml.py --check 2>&1 | tail -10 || {
    printf "${RED}✗ DBML drift. Run 'make arch-dbml' and commit.${NC}
"
    exit 1
  }
  printf "${GREEN}✓ DBML in sync${NC}
"
fi

# 6. Orval sync (если менялся OpenAPI или orval.config)
if git diff --stat origin/HEAD..HEAD --name-only 2>/dev/null | grep -qE '^(docs/api/openapi\.json|apps/backend/app/.*\.py|apps/frontend/orval\.config\.ts)$'; then
  printf "${YELLOW}→ orval sync check...${NC}\n"
  cd apps/frontend && yarn orval --config orval.config.ts 2>&1 | tail -10
  if git diff --name-only | grep -q '^apps/frontend/src/generated/'; then
    printf "${RED}✗ generated/ changed. Commit the regenerated files.${NC}\n"
    cd ../..
    exit 1
  fi
  cd ../..
  printf "${GREEN}✓ orval in sync${NC}\n"
fi

printf "${GREEN}✓ pre-push passed${NC}\n\n"
