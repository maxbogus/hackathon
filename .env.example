# ============================================================================
# Transit-AI — .env.example
# ----------------------------------------------------------------------------
# Скопируйте в .env (gitignored) и подставьте реальные значения.
# НИКОГДА не коммитьте реальные ключи. В .env.example — только плейсхолдеры.
# ============================================================================

# === INFRA ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transit_ai
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit_dev_only

REDIS_URL=redis://localhost:6379/0

# === BACKEND ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# === FRONTEND ===
FRONTEND_PORT=5173

# === MAP PROVIDER ===
# osm (бесплатно, по умолчанию) | yandex (когда есть ключ)
VITE_MAP_IMPL=osm

# Yandex Maps JavaScript API (получен для хакатона)
VITE_YANDEX_MAPS_API_KEY=your_key_here

# Yandex Geocoder API (получен для хакатона)
VITE_YANDEX_GEOCODER_API_KEY=your_key_here
VITE_YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/1.x

# === ПОИСК ОРГАНИЗАЦИЙ РЯДОМ С ОСТАНОВКАМИ ===
# overpass (бесплатно) | 2gis (бесплатно до 1000/день) | yandex (платно)
VITE_SEARCH_PROVIDER=overpass

# 2ГИС (опциональный fallback, ключ бесплатно на https://dev.2gis.ru)
VITE_TWOGIS_API_KEY=your_2gis_key_here

# === LLM ASSISTANT (lawcopilot-паттерн) ===
# openrouter | anthropic | gigachat | reasoning | deepseek
LLM_TYPE=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_REASONING_ENABLED=false
LLM_REASONING_BUDGET_SIMPLE=2000
LLM_REASONING_BUDGET_MODERATE=8000
LLM_REASONING_BUDGET_COMPLEX=16000

# Провайдеры (заполните хотя бы один)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Cloudflare AI Gateway (опционально, для аналитики и кэширования)
CLOUDFLARE_GATEWAY_URL=
CLOUDFLARE_GATEWAY_TOKEN=

# === MCP ===
MCP_ENABLED=true
MCP_TRANSPORT=stdio

# === ML ===
# Каталог с артефактами и предсказаниями (абсолютный путь)
ML_ARTIFACTS_DIR=/home/maxbogus/Repositories/hackathon/ml/artifacts
PREDICTIONS_DIR=/home/maxbogus/Repositories/hackathon/predictions

# Активная модель (id из artifacts/<id>/meta.json)
ACTIVE_MODEL_ID=baseline_v1

# === TELEMETRY (опционально) ===
# Sentry / OpenTelemetry — оставлено пустым, чтобы не падать
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# === MLOPS INFRA (T-235) ===
# MLflow tracking server (профиль `mlops` в docker-compose).
# 5000 занят локальным registry:2 -> default 5001.
MLFLOW_HOST_PORT=5001
# Airflow api-server (профиль `airflow`). 8080/8081 заняты ai-gateway.
AIRFLOW_HOST_PORT=8087
# Airflow: Fernet-ключ (шифрование connections/variables) и админ SimpleAuthManager.
# Реальный ключ сгенерировать в .env: make airflow-secrets (плейсхолдер ниже НЕ рабочий).
AIRFLOW_FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@local
# JWT-секрет api-server (Airflow 3). Для локального запуска можно оставить дефолт из compose.
AIRFLOW_JWT_SECRET=
